<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.finos.vuu.benchmarks</groupId>
    <artifactId>benchmark-server</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <!--
        Standalone project, not part of vuu's own reactor - depends on
        org.finos.vuu:vuu, built and `mvn install`ed from the vendor/vuu
        submodule (see ../scripts/start-vuu-server.ps1 and ../README.md),
        matching whichever commit is checked out there. toolbox, logback and
        typesafe-config all come in transitively through vuu itself.
    -->
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <vuu.version>13.1.0-SNAPSHOT</vuu.version>
        <vuu.scala.version>3.9.0</vuu.scala.version>
        <vuu.logback.version>1.6.5</vuu.logback.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.finos.vuu</groupId>
            <artifactId>vuu</artifactId>
            <version>${vuu.version}</version>
        </dependency>
        <!--
            vuu itself only pulls in the scala-logging API facade, not an
            SLF4J backend - without this, StrictLogging calls silently no-op
            instead of printing (no error, just missing log output).
        -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${vuu.logback.version}</version>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>src/main/scala</sourceDirectory>
        <plugins>
            <plugin>
                <groupId>net.alchim31.maven</groupId>
                <artifactId>scala-maven-plugin</artifactId>
                <version>4.9.8</version>
                <configuration>
                    <scalaVersion>${vuu.scala.version}</scalaVersion>
                    <args>
                        <arg>-deprecation</arg>
                    </args>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
